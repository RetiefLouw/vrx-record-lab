<?xml version="1.0"?>
<launch>
  <arg name="world" default="$(find vrx_gazebo)/worlds/stationkeeping_task.world" />
  <arg name="namespace" default="wamv" />
  <arg name="gui" default="false" />
  <arg name="verbose" default="false" />
  <arg name="extra_gazebo_args" default="" />
  <arg name="wamv_locked" default="false" />
  <arg name="controller_config" default="$(find vrx_controller_ros)/config/controller.yaml" />
  <arg name="localization_topic" default="/wamv/robot_localization/odometry/filtered" />

  <include file="$(find vrx_gazebo)/launch/station_keeping.launch">
    <arg name="world" value="$(arg world)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="verbose" value="$(arg verbose)" />
    <arg name="extra_gazebo_args" value="$(arg extra_gazebo_args)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="wamv_locked" value="$(arg wamv_locked)" />
    <arg name="thrust_config" value="T" />
    <arg name="vrx_sensors_enabled" value="true" />
  </include>

  <include file="$(find wamv_gazebo)/launch/localization_example.launch" />

  <rosparam command="load" file="$(arg controller_config)" />
  <node pkg="vrx_controller_ros" type="station_keeping_node.py" name="vrx_controller" output="screen">
    <param name="namespace" value="$(arg namespace)" />
    <param name="localization_topic" value="$(arg localization_topic)" />
  </node>
</launch>
