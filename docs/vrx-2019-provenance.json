  "claims": [
    {
      "id": "runtime_requirements",
      "status": "confirmed",
      "claim": "The official 2019 environment requirement was Ubuntu Desktop 18.04 Bionic 64-bit, ROS Melodic, and Gazebo 9.11.0 or newer.",
      "evidence": ["system_requirements", "technical_guide_v1_2", "vrx_docker_phase3"]
    },
    {
      "id": "vrx_package_version",
      "status": "confirmed",
      "claim": "The public vrx_gazebo package reports version 1.3.0 in the VRX 1.3.0 tag.",
      "evidence": ["vrx_tag_1_3_0"]
    },
    {
      "id": "final_window_code_anchor",
      "status": "inferred",
      "claim": "VRX commit dd6187ca2eb24838b4288bf1154031556bb73cf6 is the best public code anchor near the final submission window; it is not a confirmed evaluator checkout.",
      "reason": "The commit is the public VRX tip on 2019-11-22 and contains the final-era scorer, but the public phase-3 Dockerfile clones VRX without a revision.",
      "evidence": ["vrx_final_window_tip", "vrx_docker_phase3"]
    },
    {
      "id": "exact_evaluator_revision",
      "status": "unavailable",
      "claim": "The exact VRX commit and apt package versions used by the phase-3 evaluator are not recorded in the public harness.",
      "reason": "The Dockerfile uses an unpinned Mercurial clone and unpinned distribution packages.",
      "evidence": ["vrx_docker_phase3"]
    },
    {
      "id": "run_state_machine",
      "status": "confirmed",
      "claim": "A run transitions through Initial, Ready, Running, and Finished; scoring starts only in Running.",
      "evidence": ["task_descriptions_v1_4", "technical_guide_v1_2", "vrx_stationkeeping_source"]
    },
    {
      "id": "public_timing",
      "status": "confirmed",
      "claim": "The public station-keeping world uses 10 seconds Initial, 10 seconds Ready, and 300 seconds Running, for 320 seconds from the public simulation state-clock origin to timeout.",
      "evidence": ["vrx_tag_1_3_0"]
    },
    {
      "id": "phase3_timing",
      "status": "unavailable",
      "claim": "The exact phase-3 hidden-world durations and timeout behavior are not independently published.",
      "evidence": ["phase3_competition_page", "vrx_docker_phase3"]
    },
    {
      "id": "initial_pose",
      "status": "inferred",
      "claim": "The public auto-evaluation path starts with local pose x=158, y=108, z=0.1, roll=0, pitch=0, yaw=-2.76, but the final phase-3 harness may have overridden it.",
      "reason": "These are the sandisland.launch defaults and the public trial script does not pass pose overrides; the Technical Guide also says starting pose varies between runs.",
      "evidence": ["vrx_tag_1_3_0", "vrx_trial_harness_script", "technical_guide_v1_2"]
    },
    {
      "id": "final_initial_pose",
      "status": "unavailable",
      "claim": "The exact initial pose for each hidden phase-3 trial is not public.",
      "evidence": ["phase3_competition_page", "technical_guide_v1_2"]
    },
    {
      "id": "goal_conversion",
      "status": "confirmed",
      "claim": "The world provides goal latitude, longitude, and yaw; the plugin converts latitude/longitude through spherical WGS84 world coordinates to local X/Y and publishes a GeoPoseStamped goal with a yaw quaternion.",
      "evidence": ["vrx_stationkeeping_source", "vrx_tag_1_3_0"]
    },
    {
      "id": "final_goal_poses",
      "status": "unavailable",
      "claim": "The exact goal poses for hidden phase-3 trials are unavailable because the evaluation configurations were not released before the deadline.",
      "evidence": ["phase3_competition_page"]
    },
    {
      "id": "environment_envelope",
      "status": "confirmed",
      "claim": "The Technical Guide enumerates fog color/density, ambient light, wind mean velocity, wind variance gain/time, wind direction, and wave period/gain/direction/angle ranges.",
      "evidence": ["technical_guide_v1_2"]
    },
    {
      "id": "current_parameter",
      "status": "unavailable",
      "claim": "No current parameter appears in the enumerated public Technical Guide envelope, but hidden-evaluation use or non-use of a current is not proven.",
      "evidence": ["technical_guide_v1_2", "phase3_competition_page"]
    },
    {
      "id": "public_practice_worlds",
      "status": "confirmed",
      "claim": "The VRX 1.3.0 source contains six public phase-2 station-keeping practice worlds with explicit goal, wave, wind, seed, and 10/10/300 timing values.",
      "evidence": ["vrx_tag_1_3_0"]
    },
    {
      "id": "final_worlds",
      "status": "unavailable",
      "claim": "The six hidden phase-3 station-keeping world files and exact per-trial environment values are not public.",
      "evidence": ["phase3_competition_page", "vrx_docker_phase3"]
    },
    {
      "id": "published_rms_formula",
      "status": "confirmed",
      "claim": "The official task description specifies RMS = sqrt(sum((x_i-x_o)^2 + (y_i-y_o)^2 + W(h_i-h_o)^2) / n), with W in meters and heading in radians.",
      "evidence": ["task_descriptions_v1_4"]
    },
    {
      "id": "rms_weight",
      "status": "unavailable",
      "claim": "The official task description does not publish the numeric heading weight W, angle-wrapping rule, or an exact scorer sampling period.",
      "evidence": ["task_descriptions_v1_4"]
    },
    {
      "id": "public_stationkeeping_scorer",
      "status": "confirmed",
      "claim": "At the cited public source revision, the executable station-keeping score is the arithmetic mean over world-update samples of sqrt(dx^2 + dy^2) + 1 - abs(abs(goal_yaw-current_yaw)-pi)/pi.",
      "evidence": ["vrx_stationkeeping_source", "vrx_final_window_tip"]
    },
    {
      "id": "phase3_runtime_metric",
      "status": "inferred",
      "claim": "The public mean-pose implementation is the best reconstruction of the phase-3 executable metric, but it cannot be proven to be the exact evaluator metric.",
      "reason": "The public source history shows the change before the final event, while the public phase-3 Dockerfile does not pin the VRX checkout and the official PDF still describes RMS.",
      "evidence": ["vrx_final_window_tip", "vrx_stationkeeping_source", "task_descriptions_v1_4", "vrx_docker_phase3"]
    },
    {
      "id": "scorer_sampling",
      "status": "confirmed",
      "claim": "The scorer updates on Gazebo WorldUpdateBegin; its debug publishers are throttled to 1 Hz, which is not the scorer sample interval.",
      "evidence": ["vrx_stationkeeping_source", "task_descriptions_v1_4"]
    },
    {
      "id": "stationkeeping_penalties",
      "status": "confirmed",
      "claim": "No station-keeping-specific timeout score or penalty is present in the cited public station-keeping world/plugin; scoring is suppressed before Running and stops at Finished.",
      "evidence": ["vrx_stationkeeping_source", "vrx_tag_1_3_0"]
    },
    {
      "id": "private_wrapper_behavior",
      "status": "unavailable",
      "claim": "Any private wrapper logic around the public Docker harness is unavailable.",
      "evidence": ["vrx_docker_phase3", "phase3_competition_page"]
    },
    {
      "id": "six_trial_selection",
      "status": "confirmed",
      "claim": "The official results summarize each task over six trial runs, and UF station keeping lists six run values.",
      "evidence": ["official_results"]
    },
    {
      "id": "trial_filtering",
      "status": "unavailable",
      "claim": "No public evidence identifies any hidden filtering or selection before the six published trial values.",
      "evidence": ["official_results", "vrx_task_score_script", "phase3_competition_page"]
    },
    {
      "id": "uf_stationkeeping_result",
      "status": "confirmed",
      "claim": "The official results report UF station-keeping run scores 0.02, 0.04, 0.35, 0.04, 0.10, and 0.11, with task score 0.11 and task rank 1.",
      "evidence": ["official_results"]
    },
    {
      "id": "uf_result_arithmetic",
      "status": "confirmed",
      "claim": "The arithmetic mean of the six displayed UF values is (0.02 + 0.04 + 0.35 + 0.04 + 0.10 + 0.11) / 6 = 0.11.",
      "precision_note": "This is calculated from the displayed table; official trial_score.txt files separately give an exact mean of 0.110429677731685.",
      "evidence": ["official_results"]
    },
    {
      "id": "uf_exact_stationkeeping_scores",
      "status": "confirmed",
      "claim": "Official phase-3 trial_score.txt files report 0.020469539545113, 0.037360867340913, 0.35484590924613, 0.041314142274213, 0.095887547367613, and 0.11270006061613; their arithmetic mean is 0.110429677731685.",
      "evidence": ["official_phase3_logs"]
    },
    {
      "id": "leaderboard_task_ranks",
      "status": "confirmed",
      "claim": "Teams are ranked low-to-high by task score; DNF/DSQ receives rank equal to the number of teams for that task.",
      "evidence": ["task_descriptions_v1_4", "official_results"]
    },
    {
      "id": "leaderboard_overall_ranks",
      "status": "confirmed",
      "claim": "The overall total is the sum of task ranks, with the lowest total first; UF's published total is 25 and overall rank is 5.",
      "evidence": ["task_descriptions_v1_4", "official_results"]
    },
    {
      "id": "raw_score_artifacts",
      "status": "confirmed",
      "claim": "The official public S3 bucket exposes exact trial scores, task-info bags, server-side Gazebo state logs, and runtime logs. Generated world SDFs, image digests, and UF controller-side traces were not found in those per-trial objects.",
      "evidence": ["official_phase3_logs", "official_results", "vrx_docker_phase3"]
    }
  ],
