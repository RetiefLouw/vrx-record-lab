 #!/usr/bin/env python3
 import os
+import numpy as np
 import torch
 import rospy
 import rospkg
@@ -54,6 +55,20 @@ if __name__ == '__main__':
 
     rate = rospy.Rate(CONTROL_FREQ)
 
+    # Do not let the policy act on its zero-initialized local goal while the
+    # global planner is still publishing the first path. The released model
+    # emits a moving command for a zero goal, which can cause an avoidable
+    # startup collision in a fast local runtime. Require a stable path for
+    # one second so a transient first plan cannot arm the policy.
+    ready_cycles = 0
+    while ready_cycles < CONTROL_FREQ and not rospy.is_shutdown():
+        if len(robot.global_path) > 1 and np.linalg.norm(robot.local_goal) >= 0.1:
+            ready_cycles += 1
+        else:
+            ready_cycles = 0
+        robot.set_velocity(0.0, 0.0)
+        rate.sleep()
+
     # Initial warm-up
     for _ in range(10):
         action, _, _ = model(torch.rand(1, 720, 1).to(DEVICE), torch.rand(1, 2, 1).to(DEVICE))
